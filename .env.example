POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_SHA256=replace-with-the-generated-64-character-hash
COOKIE_SECRET=replace-with-at-least-32-random-characters
# false فقط برای اجرای HTTP محلی؛ در Production/HTTPS برابر true باشد.
COOKIE_SECURE=false
